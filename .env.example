# PlayItRight Environment Configuration Example
# Copy to .env.dev, .env.test, or .env.prod for environment-specific settings.

# Environment: dev, test, prod
PLAYITRIGHT_ENV=dev

# SQLite Database Path (file path or :memory:)
PLAYITRIGHT_DB_PATH=db/dev/library.db

# Backups and Artwork Cache Directories
PLAYITRIGHT_BACKUP_DIR=db/dev/backups
PLAYITRIGHT_ARTWORK_DIR=db/dev/artwork

# SQLite Engine Tuning
PLAYITRIGHT_BUSY_TIMEOUT=5.0
PLAYITRIGHT_CACHE_SIZE_KB=8192
PLAYITRIGHT_MAX_BACKUP_GENS=2
